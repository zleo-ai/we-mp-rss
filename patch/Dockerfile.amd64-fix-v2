# we-mp-rss amd64 补丁版 v2 = 官方 amd64 镜像 + Maple 的 driver 补丁 + webkit 持久化
#
# 相对 v1(patch/Dockerfile.amd64-fix)的两点正规化:
#  1) driver 文件从仓库主树 driver/ 目录 COPY(可版本化、可复现),而非扁平散文件。
#     wx.py 含二维码常驻活码修复(EOS-658 ②:20min 窗口 + 跟随微信轮换实时重抓)。
#  2) webkit 浏览器二进制改用 `playwright install webkit` 在构建期装入,替代
#     旧的 `docker commit` 固化 —— 根治"重建镜像即丢 webkit"(易失产物)问题。
#
# 基线 = 上游 rachelos/we-mp-rss f1d0c9d0(即 ghcr latest)。构建上下文 = 仓库根。
# 构建:  docker build -f patch/Dockerfile.amd64-fix-v2 -t we-mp-rss:amd64-fix-v2 .
FROM ghcr.io/rachelos/we-mp-rss:latest

# 落补丁版 driver(登录空白二维码防护 + 登录检测 + PID锁 + token过期 + 活码跟随)
COPY driver/wx.py /app/driver/wx.py
COPY driver/success.py /app/driver/success.py

# 把 webkit 装进镜像层(持久化,重建不丢)。app 运行在 /app/env_<arch> venv 里
# (见 start.sh: PLANT_PATH=/app/env + uname -m),故用该 venv 的 playwright 安装,
# 装到默认 /root/.cache/ms-playwright,与运行时一致。base 镜像已含 webkit 系统依赖。
RUN . "/app/env_$(uname -m)/bin/activate" && playwright install webkit
